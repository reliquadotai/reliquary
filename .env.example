# Bittensor
BT_NETWORK=finney
NETUID=81
BT_WALLET_NAME=default
BT_HOTKEY=default

# R2/S3 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ID=reliquary

# Model
CHECKPOINT_PATH=

# Validator HTTP endpoint (overridable via --http-host / --http-port on the CLI)
RELIQUARY_VALIDATOR_HTTP_HOST=0.0.0.0
RELIQUARY_VALIDATOR_HTTP_PORT=8888

# Validator ingress/admission. Keep backward drand tolerance at zero when the
# signed upload-precommit protocol is deployed to miners.
DRAND_ROUND_BACKWARD_TOLERANCE=0
RELIQUARY_MATH_ADMISSION_WORKERS=4
RELIQUARY_CODE_ADMISSION_WORKERS=2
# Emergency rollback switch for the persistent prompt-mismatch circuit breaker.
# Three mismatches in ten windows arm it; only the reserved canary recovers it.
RELIQUARY_PROMPT_MISMATCH_CIRCUIT_ENABLED=1

# Experimental checkpoint epochs (disabled; requires a coordinated 16-window
# profile before use).
# RELIQUARY_EXPERIMENTAL_CHECKPOINT_EPOCH_ENABLED=0
# RELIQUARY_EXPERIMENTAL_CHECKPOINT_EPOCH_TRAINING_MODE=sequential_steps
# Alternative local experiment: aggregate_one_step
# Manifest-to-OPEN preparation and warm-up delay, in drand rounds.
# RELIQUARY_EXPERIMENTAL_CHECKPOINT_EPOCH_WARMUP_ROUNDS=20
# Shared collection default: 16 * the active profile's per-window duration.
# RELIQUARY_EXPERIMENTAL_CHECKPOINT_EPOCH_COLLECTION_SECONDS=1600
# Proof-failure reserve above the 16 useful groups in each environment/lane.
# RELIQUARY_EXPERIMENTAL_CHECKPOINT_EPOCH_BACKUP_CANDIDATES_PER_LANE=8
# Compact commitments accepted per canonical operator and lane.
# RELIQUARY_EXPERIMENTAL_CHECKPOINT_EPOCH_COMMITMENTS_PER_OPERATOR_PER_LANE=16
# Upload interval for the post-selection reveal cohort.
# RELIQUARY_EXPERIMENTAL_CHECKPOINT_EPOCH_REVEAL_SECONDS=60

# Optional
HF_TOKEN=
