# Bittensor
BT_NETWORK=finney
NETUID=81
BT_WALLET_NAME=default
BT_HOTKEY=default

# R2/S3 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ID=reliquary

# Model
CHECKPOINT_PATH=

# Validator HTTP endpoint (overridable via --http-host / --http-port on the CLI)
RELIQUARY_VALIDATOR_HTTP_HOST=0.0.0.0
RELIQUARY_VALIDATOR_HTTP_PORT=8888

# Validator ingress/admission. Keep backward drand tolerance at zero when the
# signed upload-precommit protocol is deployed to miners.
DRAND_ROUND_BACKWARD_TOLERANCE=0
RELIQUARY_MATH_ADMISSION_WORKERS=4
RELIQUARY_CODE_ADMISSION_WORKERS=2
# Emergency rollback switch for the persistent prompt-mismatch circuit breaker.
# Three mismatches in ten windows arm it; only the reserved canary recovers it.
RELIQUARY_PROMPT_MISMATCH_CIRCUIT_ENABLED=1

# Control-plane hardening. Keep the ASGI cache enabled. Delta cooldown
# persistence requires the staged cutover in docs/control-plane-cooldown-hardening.md
# and is intentionally OFF by default for rollback compatibility.
RELIQUARY_STATE_FASTPATH=1
COOLDOWN_DELTA_SNAPSHOTS_ENABLED=0
COOLDOWN_COMPACTION_INTERVAL_WINDOWS=1000
RELIQUARY_READINESS_EVENT_LOOP_P99_MS=1000
RELIQUARY_READINESS_ENDPOINT_P99_MS=2000
RELIQUARY_READINESS_ARCHIVE_QUEUE_DEPTH=50
RELIQUARY_READINESS_ARCHIVE_OLDEST_SECONDS=900

# Optional
HF_TOKEN=
