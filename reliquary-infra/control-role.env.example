# ctrl-01 stays wallet-free. Mount both client PKI directories read-only into
# the validator container and set these values there.

# Hostile Code execution: start in shadow, switch to remote only after parity.
RELIQUARY_GRADER_EXECUTOR_URL=https://cpu-exec-01.internal:8443
RELIQUARY_GRADER_EXECUTOR_MODE=shadow
RELIQUARY_GRADER_RUNTIME_ID=grader-sha256:REPLACE_FROM_EXECUTOR_MANIFEST
RELIQUARY_GRADER_EXECUTOR_CA=/etc/reliquary/executor-client/ca.crt
RELIQUARY_GRADER_EXECUTOR_CERT=/etc/reliquary/executor-client/client.crt
RELIQUARY_GRADER_EXECUTOR_KEY=/etc/reliquary/executor-client/client.key

# Semantic signing: no local wallet path is mounted in this mode.
RELIQUARY_SIGNER_URL=https://signer-01.internal:8444
RELIQUARY_SIGNER_EXPECTED_HOTKEY=REPLACE_WITH_PUBLIC_SS58_ADDRESS
RELIQUARY_SIGNER_CA=/etc/reliquary/signer-client/ca.crt
RELIQUARY_SIGNER_CERT=/etc/reliquary/signer-client/client.crt
RELIQUARY_SIGNER_KEY=/etc/reliquary/signer-client/client.key
