RELIQUARY_SNAPSHOT_ARGS=--upstream {{ ctrl_snapshot_upstream }} --root /var/lib/reliquary-edge/snapshots --metrics-dir /var/lib/prometheus/node-exporter --state-interval {{ ctrl_snapshot_state_interval_seconds }} --health-interval {{ ctrl_snapshot_health_interval_seconds }} --timeout {{ ctrl_snapshot_timeout_seconds }} --state-stale-after {{ ctrl_snapshot_state_stale_seconds }} --health-stale-after {{ ctrl_snapshot_health_stale_seconds }}{% for environment in ctrl_snapshot_environments %} --environment {{ environment }}{% endfor %}
