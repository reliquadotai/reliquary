[Unit]
Description=Reliquary semantic hotkey signer
Requires=docker.service
After=docker.service network-online.target reliquary-signer-egress.service
Wants=network-online.target

[Service]
Type=simple
Environment=COMPOSE_PROJECT_NAME=reliquary-signer
ExecStartPre=/usr/bin/docker image inspect {{ signer_image_id }}
ExecStartPre=/usr/bin/docker compose --env-file /etc/reliquary/signer.env --file /opt/reliquary-signer/compose.yml config --quiet
ExecStart=/usr/bin/docker compose --env-file /etc/reliquary/signer.env --file /opt/reliquary-signer/compose.yml up --no-build --no-color
ExecStop=/usr/bin/docker compose --env-file /etc/reliquary/signer.env --file /opt/reliquary-signer/compose.yml down --timeout 30
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
