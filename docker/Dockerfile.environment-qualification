# syntax=docker/dockerfile:1.6
FROM python:3.12-slim@sha256:090ba77e2958f6af52a5341f788b50b032dd4ca28377d2893dcf1ecbdfdfe203
RUN apt-get update -qq && apt-get install -y -qq git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/reliquary
COPY reliquary /opt/reliquary/reliquary
COPY scripts /opt/reliquary/scripts
COPY docker/logic-release.json docker/logic-runtime-requirements.lock /opt/reliquary/docker/
ENV PYTHONPATH=/opt/reliquary PYTHONDONTWRITEBYTECODE=1
RUN --mount=type=secret,id=logic_wheel,target=/tmp/logic.whl,required=true \
    python scripts/install_logic_runtime.py --wheel /tmp/logic.whl
CMD ["python", "scripts/install_logic_runtime.py", "--verify-only"]
