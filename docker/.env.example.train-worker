# Detached trainer (reliquary train-worker) — copy to docker/.env on the
# trainer box. See docs/detached-trainer.md for the full runbook.

# ---- image / runtime ----
# Override until the branch is in the published image (e.g. a locally
# built tag): TRAIN_WORKER_IMAGE=reliquary-validator:detached-trainer
# TRAIN_WORKER_IMAGE=ghcr.io/reliquadotai/reliquary-validator:latest
# Which GPU this trainer owns on the box.
TRAIN_WORKER_GPU=0
# "--shadow" = consume + train but NEVER publish (pre-cutover phase).
# Empty = live trainer (publishes checkpoints).
TRAIN_WORKER_FLAGS=--shadow

# ---- protocol / run identity ----
# Must match the validator exactly. Protocol v6 rejects legacy candidate
# manifests and training payloads instead of continuing the previous run.
# The capability flag is not optional here: this process imports the same
# constants as the validator, so the v6 profile without it refuses to boot.
RELIQUARY_PROTOCOL_PROFILE=qwen3-4b-base-dapo-fill-closed-v6
RELIQUARY_EXPERIMENTAL_FILL_CLOSED_ENABLED=1
RELIQUARY_TRAINING_RUN_ID=fill-closed-v6-20260907

# ---- checkpoint repo (write token) ----
# The existing append-only repo may retain its historical name; the stamped
# checkpoint profile, not the repository name, is the protocol authority.
RELIQUARY_HF_REPO_ID=ReliquaryForge/qwen3-4b-base-dapo-v4
HF_TOKEN=<hf write token>

# ---- R2 (same credentials as the validator) ----
R2_ACCOUNT_ID=<account id>
R2_ACCESS_KEY_ID=<key id>
R2_SECRET_ACCESS_KEY=<secret>
R2_BUCKET_ID=reliquary
# R2_ENDPOINT_URL=  # optional; derived from the account id when unset

# ---- bootstrap (FIRST start only; the candidate manifest takes over
# after the first publish) ----
# Fresh v6 cutover: the first consumed payload must be a v6 window from the
# v6-stamped base-reset checkpoint.
#
# CAREFUL — under v6 this is NOT a window number. The journal is keyed
# ``window * 16 + batch_index`` because one window emits 16 training batches,
# and the bootstrap cursor is taken as already being in that space (it carries
# no marker, so nothing migrates it for you). Passing a raw window number here
# parks the trainer inside a long-finished window. Write it out:
RELIQUARY_TRAINER_BOOTSTRAP_CURSOR=<window_n * 16 + batch_index>
# HF sha of the freshly published, v6-stamped Qwen3-4B-Base reset.
RELIQUARY_TRAINER_BOOTSTRAP_REVISION=<hf sha>
# The base reset's append-only checkpoint number — numbering must never regress.
RELIQUARY_TRAINER_CHECKPOINT_N=<n>

# ---- append-only HF quota guard ----
# Read-only projected-usage check before upload. It never prunes or rewrites the
# active run; finished-run compaction is a separate manual operator procedure.
RELIQUARY_HF_STORAGE_FREEZE_TB=11.0

# ---- telemetry (the shadow comparison is blind without it) ----
WANDB_API_KEY=<key>
RELIQUARY_WANDB_VERSION=detached-shadow
RELIQUARY_TRAINER_WANDB_IDENTITY=trainer0
# WANDB_ENTITY=alphatao-alphatao

# ---- optional ----
# RELIQUARY_TRAINER_STATE_DIR=/root/reliquary/trainer
# RELIQUARY_TRAINER_WINDOW_STRIDE=1
# RELIQUARY_DISABLE_TRAIN=0   # =1 freezes the trainer (incident lever)
