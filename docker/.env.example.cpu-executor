# Build/runtime identity
CPU_EXECUTOR_IMAGE=reliquary-cpu-executor:prototype
RELIQUARY_BUILD_REVISION=<branch commit SHA>
RELIQUARY_CPU_EXECUTOR_ID=cpu-exec-01

# Bind the published port to the execution host's PRIVATE address only.
RELIQUARY_CPU_EXECUTOR_BIND_IP=10.81.20.2
RELIQUARY_CPU_EXECUTOR_HOST=0.0.0.0
RELIQUARY_CPU_EXECUTOR_PORT=8443

# Small-machine prototype. Raise only after queue/load telemetry proves need.
RELIQUARY_CPU_EXECUTOR_POOL_SIZE=16
RELIQUARY_CPU_EXECUTOR_MAX_INFLIGHT=16

# Production default is 0: destroy/replace each gVisor sandbox after one
# candidate batch. Set 1 only for an isolated performance comparison.
RELIQUARY_CPU_EXECUTOR_REUSE_WORKERS=0

# mTLS: server cert/key plus the CA that signed ctrl-01's client certificate.
RELIQUARY_CPU_EXECUTOR_TLS_CERT=/etc/reliquary/pki/server.crt
RELIQUARY_CPU_EXECUTOR_TLS_KEY=/etc/reliquary/pki/server.key
RELIQUARY_CPU_EXECUTOR_CLIENT_CA=/etc/reliquary/pki/ca.crt
RELIQUARY_CPU_EXECUTOR_PKI_DIR=./pki/cpu-executor

# Optional explicit semantic runtime identity. When omitted, both sides digest
# worker.py + bundle/config.json and reject a mismatch automatically.
# RELIQUARY_GRADER_RUNTIME_ID=grader-sha256:<64 lowercase hex>

LOG_LEVEL=INFO
