# Bittensor
BT_NETWORK=finney
BT_NETUID=81
BT_WALLET_NAME=subnet
BT_HOTKEY=hotkey1

# Trainer mode
RELIQUARY_TRAIN=1
RELIQUARY_PROTOCOL_PROFILE=qwen3-4b-base-dapo-reasoning-v5
RELIQUARY_CHECKPOINT=Qwen/Qwen3-4B-Base
RELIQUARY_HF_REPO_ID=your-org/reliquary-sn
RELIQUARY_HTTP_HOST=0.0.0.0
RELIQUARY_HTTP_PORT=8080
# Optional — advertise on-chain so miners can discover the validator via metagraph:
# RELIQUARY_EXTERNAL_IP=1.2.3.4
# RELIQUARY_EXTERNAL_PORT=8080
# Required for v5 activation: a fresh, v5-stamped base-reset checkpoint.
# Create it with scripts/publish_base_reset_checkpoint.py under the v5 profile;
# do not point this at a v4-trained checkpoint for the clean baseline.
# RELIQUARY_RESUME_FROM=sha:fa53996ed1533fadfc86be0e6158ddd8465acf34

# Remote Code sandbox prototype. Leave URL unset for today's local runsc path.
# Once enabled, expected answers/comparison stay here; only code + call args
# cross mTLS to cpu-exec-01.
# RELIQUARY_GRADER_EXECUTOR_URL=https://10.81.20.2:8443
# Start with shadow: local runsc remains authoritative and parity is exported.
# Change to remote only after the documented qualification gate passes.
# RELIQUARY_GRADER_EXECUTOR_MODE=shadow
# RELIQUARY_GRADER_EXECUTOR_CA=/etc/reliquary/grader-client-pki/ca.crt
# RELIQUARY_GRADER_EXECUTOR_CERT=/etc/reliquary/grader-client-pki/client.crt
# RELIQUARY_GRADER_EXECUTOR_KEY=/etc/reliquary/grader-client-pki/client.key
# RELIQUARY_GRADER_CLIENT_PKI_DIR=./pki/grader-client
# Authoritative remote mode only (shadow still needs local runsc privileges):
# RELIQUARY_GRADER_PRIVILEGED=false
# RELIQUARY_CGROUP_MODE=private
# UID 1000 migration is separate; current state/HF mounts may be root-owned.
# RELIQUARY_DROP_VALIDATOR_PRIVILEGES=1

# Protocol v3+: exact measured proof fleet and immutable qualification.
# The device list names PHYSICAL cards and must match the manifest exactly.
# RELIQUARY_PROOF_DEVICES=<exact-canonical-list-from-capacity-manifest>
# RELIQUARY_PROOF_CAPACITY_MANIFEST=/root/reliquary/state/proof-capacity.json
# RELIQUARY_PROOF_CAPACITY_MANIFEST_SHA256=<64-lowercase-hex>

# ── Proof plane performance. Read docs/validating.md "Proof slots" first. ──
# These three move together; each one alone gives you a fraction of the gain.
#
# 1. Isolation: the proof plane runs in its own processes, off this
#    interpreter's GIL. Cost per proof -44% (measured 2026-08-24). It REQUIRES
#    the detached trainer below, and it also moves this process's own
#    train/verify replicas to host RAM — budget ~24 GB of host RAM for them.
# RELIQUARY_PROOF_PROCESS_ISOLATION=1
#
# 2. Detached trainer: optimizer steps and checkpoint publication move to a
#    separate box (docker/docker-compose.train-worker.yml). Required by
#    isolation, and startup refuses the combination without it.
# RELIQUARY_DETACHED_TRAINER=1
# RELIQUARY_WRITE_TRAINING_PAYLOADS=1
#
# 3. Proof slots: processes per GPU. One slot leaves an H100 at 39%
#    utilisation because a proof is 87% fixed dispatch. Measured over 192
#    archived rollouts, with the MPS daemon below running:
#        slots     1        2        4        8
#        time   12.1 s    6.3 s    5.7 s    5.8 s   (plateau)
#    Budget 10.2 GB of VRAM per slot and stay under ~88% card occupancy,
#    where the allocator cliff starts. No verdict changes: the whole matrix
#    returned 192/192 rollouts bit-identical.
# RELIQUARY_PROOF_SLOTS_PER_DEVICE=2
#
# The MPS pipe directory must be identical here, on the host daemon, and in
# the compose bind mount. WITHOUT the daemon the slots time-slice and 4 slots
# measure 8.3 s instead of 5.7 s — the validator warns at boot when the pipe
# is missing, but nothing detects a broken IPC namespace, so confirm the gain
# with the 1-slot vs 4-slot timing. Start it on the HOST with:
#     scripts/setup_cuda_mps.sh
# It also installs a systemd unit so the daemon survives a host reboot;
# the container restarts on its own and would otherwise come back slower.
# CUDA_MPS_PIPE_DIRECTORY=/tmp/nvidia-mps
#
# MPS also needs the host IPC namespace (shared memory, not just the pipe).
# Opt-in: it hands host SysV IPC and /dev/shm to a container that runs
# untrusted submissions, and one slot gains nothing from it. Slots only.
# RELIQUARY_IPC_MODE=host

# Training stability controls. A fixed KL reference must use an immutable
# 40-character Hugging Face revision and an explicitly selected beta.
# v5 inherits v4's KL_BETA=0. If re-enabled, pin the reference immutably.
# RELIQUARY_KL_BASE_MODEL=Qwen/Qwen3-4B-Base@906bfd4b4dc7f14ee4320094d8b41684abff8539
# RELIQUARY_KL_BETA=0
# RELIQUARY_LEARNING_RATE=0.000001
# RELIQUARY_RECOMPUTE_PI_OLD_FROM_VERIFY=true
# RELIQUARY_GRAD_NORM_SKIP_THRESHOLD=100
# Fraction of completion tokens allowed outside PPO's [0.8, 1.2] ratio band.
# A value of 1 disables this circuit breaker. The checkpoint-15 recovery replay
# must be calibrated before tightening the v5 default.
# RELIQUARY_PPO_RATIO_OUTSIDE_CLIP_SKIP_THRESHOLD=0.5
# Validator-only advantage shaping; zero disables the shaping intervention.
# RELIQUARY_SHAPE_PENALTY=0
# RELIQUARY_SHAPE_LEN_FRAC=0.5
# Change this identity only when deliberately starting a fresh training run.
# RELIQUARY_TRAINING_RUN_ID=reasoning-prompt-v5-20260822
# Stop automatically after publishing this checkpoint; zero means unlimited.
# RELIQUARY_TRAIN_UNTIL_CHECKPOINT_N=0

# Emergency freeze: validation, scoring, archive publishing, and weight setting
# stay live while optimizer steps and checkpoint publication are disabled.
# RELIQUARY_DISABLE_TRAIN=1

# HuggingFace (write access to RELIQUARY_HF_REPO_ID)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# R2 (write access — trainer archives windows + reads for bootstrap)
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_ID=reliquary
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ENDPOINT_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
