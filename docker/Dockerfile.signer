# syntax=docker/dockerfile:1.6
ARG PYTHON_IMAGE=python:3.12-slim@sha256:090ba77e2958f6af52a5341f788b50b032dd4ca28377d2893dcf1ecbdfdfe203
FROM ${PYTHON_IMAGE}

ARG RELIQUARY_BUILD_REVISION=unknown

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/opt/reliquary \
    RELIQUARY_BUILD_REVISION=${RELIQUARY_BUILD_REVISION}

COPY docker/signer-requirements.lock /tmp/signer-requirements.lock
RUN pip install --require-hashes --no-deps \
      --requirement /tmp/signer-requirements.lock \
 && rm -f /tmp/signer-requirements.lock \
 && groupadd --gid 10001 reliquary-signer \
 && useradd --uid 10001 --gid 10001 --no-create-home \
      --shell /usr/sbin/nologin reliquary-signer

WORKDIR /opt/reliquary
COPY reliquary/__init__.py /opt/reliquary/reliquary/__init__.py
COPY reliquary/signer /opt/reliquary/reliquary/signer
RUN printf '%s\n' "${RELIQUARY_BUILD_REVISION}" > /opt/reliquary/.build-revision \
 && python -m py_compile /opt/reliquary/reliquary/signer/*.py

LABEL org.opencontainers.image.title="Reliquary semantic hotkey signer" \
      org.opencontainers.image.revision="${RELIQUARY_BUILD_REVISION}" \
      org.opencontainers.image.source="https://github.com/reliqua-ai/reliquary"

USER 10001:10001
EXPOSE 8444
ENTRYPOINT ["python", "-m", "reliquary.signer.server"]
