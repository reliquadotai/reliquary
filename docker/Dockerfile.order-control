# syntax=docker/dockerfile:1.6
# The order control (`reliquary corpus order-control`): the validator image,
# plus the packaged sources generation orders draw from, layered the way the
# production corpus image is (prod image + `pip install` of the reviewed
# environment wheels from reliquary-environments). See docs/runbooks/order-control.md.
#
#   docker build -f docker/Dockerfile.order-control \
#     --build-arg BASE_IMAGE=<the validator image, a -logic one> \
#     --build-context envs=<directory holding exactly the four reviewed wheels> .
#
# Wheels (distribution -> source):
#   reliquary-logic                  -> reliquary_logic_v2
#   reliquary-dapo-math              -> reliquary_dapo_math_v1
#   reliquary-instruction-following  -> reliquary_instruction_following_v1
#   reliquary-code                   -> reliquary_code_v1
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN --mount=type=bind,from=envs,target=/tmp/envs \
    pip install /tmp/envs/reliquary_logic-*.whl \
                /tmp/envs/reliquary_dapo_math-*.whl \
                /tmp/envs/reliquary_instruction_following-*.whl \
                /tmp/envs/reliquary_code-*.whl

# Signed-sandbox episode orders (SWE, TMax): the same lines as the RL launch / eval
# validator overlay (Dockerfile.rl-launch) and the corpus -sbx image: reliquary-sandbox
# with its verifiers bridge at SANDBOX_COMMIT, and the env packages at the commit the
# agentic eval sets pin (record 0's env_package). reliquary-harness comes with the base.
ARG ENVS=15ad131b473f59f46b62d363bfacf430f4931f39
ARG SBX=f8c208bd35848a13cf5b9e44b64309d835d1d81e
ARG SWE_ENV_PACKAGE=reliquary-swe==0.3.0+ge8e1f1ed62a639ae.vfb2
ARG TERMINAL_ENV_PACKAGE=reliquary-terminal==0.3.1+gcd4df2dcc1aaf175.vfb2
RUN E="git+https://github.com/reliquadotai/reliquary-environments.git@${ENVS}" \
 && pip install \
      "reliquary-sandbox[verifiers] @ git+https://github.com/reliquadotai/reliquary-sandbox.git@${SBX}" \
      "reliquary-swe @ ${E}#subdirectory=environments/code/reliquary_swe" \
      "reliquary-terminal @ ${E}#subdirectory=environments/code/reliquary_terminal" \
      "renderers==0.1.11"

# The Verifiers tasksets single-turn eval sets are graded with (built against these),
# in their own directory at the END of sys.path: the venv's versions always win.
ARG TASKSETS_REPO=git+https://github.com/PrimeIntellect-ai/research-environments.git@f2e0d70968f9d89421c8035091febee8e9ac3975
RUN R="${TASKSETS_REPO}#subdirectory=environments" \
 && pip install --target /opt/evalsets-site \
      "aime25 @ ${R}/math/aime25" "aime26 @ ${R}/math/aime26" "gpqa @ ${R}/science/gpqa" \
      "ifbench @ ${R}/if/ifbench" "mmlu-pro @ ${R}/knowledge/mmlu_pro" \
      "livecodebench @ ${R}/code/livecodebench" \
 && echo /opt/evalsets-site > "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/zzz-evalsets.pth"
# Reliquary's own single-turn tasksets (tasksets/): HMMT Feb 2026, GraphWalks, OpenAI MRCR,
# HLE-Diamond deterministic subset, SciCode (graded by the SciCode grading service). Non-editable
# installs, so their artifact hashes match the sets.
# tiktoken is MRCR's row selection (o200k_base bins); hle-diamond needs HF_TOKEN of an admitted account.
COPY tasksets /tmp/reliquary-tasksets
RUN pip install --target /opt/evalsets-site --no-deps \
      /tmp/reliquary-tasksets/hmmt_feb_2026 /tmp/reliquary-tasksets/graphwalks_single_turn \
      /tmp/reliquary-tasksets/openai_mrcr_single_turn /tmp/reliquary-tasksets/hle_diamond_text_det \
      /tmp/reliquary-tasksets/scicode_steps \
 && pip install "tiktoken>=0.7" && rm -rf /tmp/reliquary-tasksets

# Fails the build unless bittensor_drand (the partial audit's draw), the hub
# and tokenizer libraries import and every package verifies against the
# catalog digest orders are qualified on.
RUN reliquary corpus order-control-check

# Fails the build unless a signed episode job could be served: the pinned sandbox,
# harness and renderers, each env's bridged identity, and the tasksets.
RUN SWE_ENV_PACKAGE="${SWE_ENV_PACKAGE}" TERMINAL_ENV_PACKAGE="${TERMINAL_ENV_PACKAGE}" SBX="${SBX}" \
    python - <<'PY'
import importlib, importlib.metadata as md, importlib.util, os, sys
from reliquary.sandbox import SANDBOX_COMMIT, require_sandbox, sandbox_commit_refusal
from reliquary.environment.agentic_swe import RENDERERS_VERSION, harness_refusal
from reliquary.environment.bridged_swe import installed_env_package
assert SANDBOX_COMMIT == os.environ["SBX"], SANDBOX_COMMIT
require_sandbox()
assert sandbox_commit_refusal(SANDBOX_COMMIT) is None, sandbox_commit_refusal(SANDBOX_COMMIT)
assert harness_refusal() is None, harness_refusal()
assert md.version("renderers") == RENDERERS_VERSION, md.version("renderers")
importlib.import_module("reliquary_sandbox_verifiers")
assert installed_env_package("reliquary-swe") == os.environ["SWE_ENV_PACKAGE"], installed_env_package("reliquary-swe")
assert installed_env_package("reliquary-terminal") == os.environ["TERMINAL_ENV_PACKAGE"], installed_env_package("reliquary-terminal")
for name in ("aime25", "aime26", "gpqa", "ifbench", "mmlu_pro", "livecodebench", "hmmt_feb_2026",
             "graphwalks_single_turn", "openai_mrcr_single_turn", "hle_diamond_text_det", "scicode_steps"):
    importlib.import_module(name)
assert "/opt/evalsets-site" in sys.path
assert not importlib.util.find_spec("verifiers").origin.startswith("/opt/evalsets-site/")
print("ORDER_CONTROL_EPISODES_OK")
PY

LABEL ai.reliquary.role="order-control" \
      ai.reliquary.envs-commit="${ENVS}" ai.reliquary.sandbox-commit="${SBX}"
EXPOSE 8791
# No wallet and no grader of single-turn orders. Signed episode orders need the order
# control's own sandbox token key (never the corpus validator's), mounted at run time:
#   -v <key.pem, 0600>:/run/reliquary/sandbox-order-control.pem:ro
#   -e RELIQUARY_SANDBOX_VALIDATOR_KEY_FILE=/run/reliquary/sandbox-order-control.pem
#   -e RELIQUARY_SANDBOX_VALIDATOR_KEY_ID=<its key id> -e RELIQUARY_SANDBOX_VALIDATOR_HOTKEY=<ss58>
#   -e RELIQUARY_SANDBOX_MACHINE_IDS='["<gateway id>", ...]'
ENTRYPOINT ["reliquary", "corpus", "order-control", "--host", "0.0.0.0", "--port", "8791"]
