# syntax=docker/dockerfile:1.6
# The order control (`reliquary corpus order-control`): the validator image,
# plus the packaged sources generation orders draw from, layered the way the
# production corpus image is (prod image + `pip install` of the reviewed
# environment wheels from reliquary-environments). See docs/runbooks/order-control.md.
#
#   docker build -f docker/Dockerfile.order-control \
#     --build-arg BASE_IMAGE=ghcr.io/reliquadotai/reliquary-validator@sha256:<digest> \
#     --build-context envs=<directory holding exactly the four reviewed wheels> .
#
# BASE_IMAGE: a -logic validator image, pinned by digest, never by tag (latest moves
# with main). Build once and push: check the pushed digest and switch to it, since the
# pip installs below resolve dependencies at build time and a second build is another image.
#
# Wheels (distribution -> source):
#   reliquary-logic                  -> reliquary_logic_v2
#   reliquary-dapo-math              -> reliquary_dapo_math_v1
#   reliquary-instruction-following  -> reliquary_instruction_following_v1
#   reliquary-code                   -> reliquary_code_v1
#
# The other RL training envs (a training order may name any env of a Gumbel profile with live RL
# rows: `reliquary.admin.training.trainable_environments`) are installed from reliquary-environments
# at a pinned commit, below; their artifact pins each file's digest and the version, so the source
# of the bytes does not matter and a wrong commit fails `order-control-check`.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN --mount=type=bind,from=envs,target=/tmp/envs \
    pip install /tmp/envs/reliquary_logic-*.whl \
                /tmp/envs/reliquary_dapo_math-*.whl \
                /tmp/envs/reliquary_instruction_following-*.whl \
                /tmp/envs/reliquary_code-*.whl

# Signed-sandbox episode orders (SWE, TMax): the same lines as the RL launch / eval
# validator overlay (Dockerfile.rl-launch) and the corpus -sbx image: reliquary-sandbox
# with its verifiers bridge at SANDBOX_COMMIT, and the env packages at the commit the
# agentic eval sets pin (record 0's env_package). reliquary-harness comes with the base.
ARG ENVS=15ad131b473f59f46b62d363bfacf430f4931f39
ARG SBX=d680d5e6f694c650f74b9dea4bc62930aad45da0
ARG SWE_ENV_PACKAGE=reliquary-swe==0.3.0+ge8e1f1ed62a639ae.vfb2
ARG TERMINAL_ENV_PACKAGE=reliquary-terminal==0.3.1+gcd4df2dcc1aaf175.vfb2
# Terminal-Bench 2.1 (reliquary-terminal-bench): its own commit of the envs repository.
ARG TB_ENVS=a7718445c156a36eec2835c43d5fb6c86c045a5e
ARG TB_ENV_PACKAGE=reliquary-terminal-bench==0.1.0+g683caef3ad3c8770.vfb2
RUN E="git+https://github.com/reliquadotai/reliquary-environments.git@${ENVS}" \
 && pip install \
      "reliquary-sandbox[verifiers] @ git+https://github.com/reliquadotai/reliquary-sandbox.git@${SBX}" \
      "reliquary-swe @ ${E}#subdirectory=environments/code/reliquary_swe" \
      "reliquary-terminal @ ${E}#subdirectory=environments/code/reliquary_terminal" \
      "renderers==0.1.11" \
 && pip install --no-deps "reliquary-terminal-bench @ git+https://github.com/reliquadotai/reliquary-environments.git@${TB_ENVS}#subdirectory=environments/code/reliquary_terminal_bench"

# The other agentic eval envs, each at the commit of the envs repository that
# `reliquary.miner.env_packages` pins for miners. DeepSWE v1.1 and SWE-bench Pro V2 are bridged
# like Terminal-Bench: a job pins that commit and record 0's identity, both checked below.
# AutomationBench is a suite env this control replays, pinned by its registry artifact.
# --no-deps, as Terminal-Bench: their requirements (verifiers==0.3.1, which the bridge's b2e4e81
# is; AutomationBench's pydantic>=2.11,<3) are already installed, and the check below imports each.
ARG DEEPSWE_ENVS=faaefd675e6f6583e6e1ce3f3a3eca109fe8e766
ARG DEEPSWE_ENV_PACKAGE=reliquary-deepswe==0.1.0+g48decd56127255d7.vfb2
ARG SWEPRO_ENVS=d2cf12b1c144515397fae634f5e848f7df55c180
ARG SWEPRO_ENV_PACKAGE=reliquary-swebench-pro==0.1.0+g9612511bc54064f7.vfb2
ARG AUTOMATIONBENCH_ENVS=b404a0bb93b289a44ae242c001148f21982812a7
RUN E="git+https://github.com/reliquadotai/reliquary-environments.git" \
 && pip install --no-deps \
      "reliquary-deepswe @ ${E}@${DEEPSWE_ENVS}#subdirectory=environments/code/reliquary_deepswe" \
      "reliquary-swebench-pro @ ${E}@${SWEPRO_ENVS}#subdirectory=environments/code/reliquary_swebench_pro" \
      "reliquary-automationbench @ ${E}@${AUTOMATIONBENCH_ENVS}#subdirectory=environments/tool_use/reliquary_automationbench"

# RL training envs beyond the four wheels (`reliquary rl supervise` runs from this image; an order
# naming one whose distribution is missing crashes its controller at load). Their packages are
# identical at ENVS and at the commit their artifacts were last cut. reliquary-telecom-solo is
# 0.1.0a1 (reliquary_telecom_solo_v1, the one the Gumbel profiles name) at its own commit: v2 is
# 0.2.0a1 of the same distribution, so one image carries one of the two.
# Runtime data: science, competitive-code and general fetch their corpus from public Hub datasets
# at pinned revisions (or RELIQUARY_GENERAL_DATA); envscaler_tools_v2 (built in) reads
# RELIQUARY_ENVSCALER_DATA; hard-math and telecom ship theirs in the package.
ARG TELECOM_ENVS=a003ffedf4f34bd62d19cdd470920ea497677fdc
RUN E="git+https://github.com/reliquadotai/reliquary-environments.git" \
 && pip install \
      "reliquary-hard-math @ ${E}@${ENVS}#subdirectory=environments/reasoning/reliquary_hard_math" \
      "reliquary-science @ ${E}@${ENVS}#subdirectory=environments/reasoning/reliquary_science" \
      "reliquary-competitive-code @ ${E}@${ENVS}#subdirectory=environments/code/reliquary_competitive_code" \
      "reliquary-general @ ${E}@${ENVS}#subdirectory=environments/general/reliquary_general" \
      "reliquary-telecom-solo @ ${E}@${TELECOM_ENVS}#subdirectory=environments/tool_use/reliquary_telecom_solo"

# The Verifiers tasksets single-turn eval sets are graded with (built against these),
# in their own directory at the END of sys.path: the venv's versions always win.
ARG TASKSETS_REPO=git+https://github.com/PrimeIntellect-ai/research-environments.git@f2e0d70968f9d89421c8035091febee8e9ac3975
RUN R="${TASKSETS_REPO}#subdirectory=environments" \
 && pip install --target /opt/evalsets-site \
      "aime24 @ ${R}/math/aime24" "aime25 @ ${R}/math/aime25" "aime26 @ ${R}/math/aime26" \
      "math500 @ ${R}/math/math500" "apex-shortlist @ ${R}/math/apex_shortlist" "gpqa @ ${R}/science/gpqa" \
      "ifbench @ ${R}/if/ifbench" "mmlu-pro @ ${R}/knowledge/mmlu_pro" \
      "livecodebench @ ${R}/code/livecodebench" \
 && echo /opt/evalsets-site > "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/zzz-evalsets.pth"
# Reliquary's own single-turn tasksets (tasksets/): HMMT Feb 2026, GraphWalks, OpenAI MRCR,
# HLE-Diamond deterministic subset, SciCode (graded by the SciCode grading service). Non-editable
# installs, so their artifact hashes match the sets.
# tiktoken is MRCR's row selection (o200k_base bins); hle-diamond needs HF_TOKEN of an admitted account.
COPY tasksets /tmp/reliquary-tasksets
RUN pip install --target /opt/evalsets-site --no-deps \
      /tmp/reliquary-tasksets/hmmt_feb_2026 /tmp/reliquary-tasksets/graphwalks_single_turn \
      /tmp/reliquary-tasksets/openai_mrcr_single_turn /tmp/reliquary-tasksets/hle_diamond_text_det \
      /tmp/reliquary-tasksets/scicode_steps \
 && pip install "tiktoken>=0.7" && rm -rf /tmp/reliquary-tasksets

# Fails the build unless bittensor_drand (the partial audit's draw), the hub
# and tokenizer libraries import, every package verifies against the
# catalog digest orders are qualified on, and every env a training order may
# name is built in or installed at the artifact the registry pins.
RUN reliquary corpus order-control-check

# Fails the build unless an episode job could be served: the pinned sandbox, harness and
# renderers, each env's bridged identity, the suite env's artifact, every env package at the
# commit miners install, and the tasksets.
RUN SWE_ENV_PACKAGE="${SWE_ENV_PACKAGE}" TERMINAL_ENV_PACKAGE="${TERMINAL_ENV_PACKAGE}" SBX="${SBX}" \
    TB_ENV_PACKAGE="${TB_ENV_PACKAGE}" DEEPSWE_ENV_PACKAGE="${DEEPSWE_ENV_PACKAGE}" \
    SWEPRO_ENV_PACKAGE="${SWEPRO_ENV_PACKAGE}" \
    python - <<'PY'
import importlib, importlib.metadata as md, importlib.util, os, sys
from reliquary.sandbox import SANDBOX_COMMIT, require_sandbox, sandbox_commit_refusal
from reliquary.environment.agentic_swe import RENDERERS_VERSION, harness_refusal
from reliquary.environment.agentic.external import verify_external_artifact
from reliquary.environment.bridged_swe import installed_env_package
from reliquary.environment.registry import ENVIRONMENT_SPECS
from reliquary.miner.env_packages import ENV_PACKAGES
from reliquary.shared.dist_commit import dist_commit
assert SANDBOX_COMMIT == os.environ["SBX"], SANDBOX_COMMIT
require_sandbox()
assert sandbox_commit_refusal(SANDBOX_COMMIT) is None, sandbox_commit_refusal(SANDBOX_COMMIT)
assert harness_refusal() is None, harness_refusal()
assert md.version("renderers") == RENDERERS_VERSION, md.version("renderers")
importlib.import_module("reliquary_sandbox_verifiers")
assert installed_env_package("reliquary-swe") == os.environ["SWE_ENV_PACKAGE"], installed_env_package("reliquary-swe")
assert installed_env_package("reliquary-terminal") == os.environ["TERMINAL_ENV_PACKAGE"], installed_env_package("reliquary-terminal")
assert installed_env_package("reliquary-terminal-bench") == os.environ["TB_ENV_PACKAGE"], installed_env_package("reliquary-terminal-bench")
assert installed_env_package("reliquary-deepswe") == os.environ["DEEPSWE_ENV_PACKAGE"], installed_env_package("reliquary-deepswe")
assert installed_env_package("reliquary-swebench-pro") == os.environ["SWEPRO_ENV_PACKAGE"], installed_env_package("reliquary-swebench-pro")
verify_external_artifact(ENVIRONMENT_SPECS["reliquary_automationbench_v1"])
for pinned in ENV_PACKAGES:
    assert pinned.accepts(dist_commit(pinned.distribution)), (pinned.distribution, dist_commit(pinned.distribution))
for name in ("reliquary_terminal_bench", "reliquary_deepswe", "reliquary_swebench_pro", "reliquary_automationbench"):
    importlib.import_module(name)
for name in ("aime24", "aime25", "aime26", "math500", "apex_shortlist", "gpqa", "ifbench", "mmlu_pro",
             "livecodebench", "hmmt_feb_2026", "graphwalks_single_turn", "openai_mrcr_single_turn",
             "hle_diamond_text_det", "scicode_steps"):
    importlib.import_module(name)
assert "/opt/evalsets-site" in sys.path
assert not importlib.util.find_spec("verifiers").origin.startswith("/opt/evalsets-site/")
print("ORDER_CONTROL_EPISODES_OK")
PY

LABEL ai.reliquary.role="order-control" \
      ai.reliquary.envs-commit="${ENVS}" ai.reliquary.telecom-envs-commit="${TELECOM_ENVS}" \
      ai.reliquary.sandbox-commit="${SBX}"
EXPOSE 8791
# No wallet and no grader of single-turn orders. Signed episode orders need the order
# control's own sandbox token key (never the corpus validator's), mounted at run time:
#   -v <key.pem, 0600>:/run/reliquary/sandbox-order-control.pem:ro
#   -e RELIQUARY_ORDER_SANDBOX_KEY_FILE=/run/reliquary/sandbox-order-control.pem
#   -e RELIQUARY_ORDER_SANDBOX_KEY_ID=<its key id> -e RELIQUARY_ORDER_SANDBOX_HOTKEY=<ss58>
#   -e RELIQUARY_SANDBOX_MACHINE_IDS='["<gateway id>", ...]'
ENTRYPOINT ["reliquary", "corpus", "order-control", "--host", "0.0.0.0", "--port", "8791"]
